<!DOCTYPE html>
<html lang="fr" data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark" />
        <title>{% block title %}GLSR!{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.ico') }}">
        {% block stylesheets %}
            <script src="https://kit.fontawesome.com/7dde808140.js" crossorigin="anonymous"></script>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block header %}
            <header>
                <nav>
                    <ul>
                        <li class="navbar-brand">
                            <a href="{{ path('home') }}" class="logo">Application</a>
                        </li>
                    </ul>
                    <ul>
                        <li><a href="{{ path('admin_index') }}" role="button">{{ 'admin.titlePage'|trans }}</a></li>
                        <li><a href="{{ path('inventory_index') }}" role="button">{{ 'inventory.titlePage'|trans }}</a></li>
                        <li><a href="#" role="button">{{ 'connection'|trans }}</a></li>
                    </ul>
                </nav>
            </header>

        {% endblock %}

        <div id="container" class="container">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <twig:Flashes label="{{ label }}" message="{{ message }}" />
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}

        </div>
    </body>
</html>
