{% set uuid, key, previousLevel = null, 0, 1 %}

<div id="{{ familyLog.vars.id }}">
    {{ form_label(familyLog) }}
    {{ form_errors(familyLog) }}
    <ul>
        {% if form.vars.value.parent.uuid is defined %}
            {% set uuid = form.vars.value.parent.uuid %}
        {% else %}
            {% set uuid = familyLog.vars.value %}
        {% endif %}
        {% for levelLabel, value in field_choices(familyLog) %}
            {% set levelLabel = levelLabel | split('-') %}
            {% set level, children, label = levelLabel[0], levelLabel[1], levelLabel[2] %}
            {% if children == 1 and level == 1 and previousLevel != level %}
                {% for iter in range(1, (previousLevel - level)) %}
                        </li>
                    </ul>
                {% endfor %}
                <ul>
            {% else %}
                </li>
            {% endif %}
                <li class="li-unstyled">
                    <input type="radio" name="{{ field_name(familyLog) }}" id="{{ familyLog.vars.id ~ key  }}"
                           value="{{ value }}"
                           class="accordion_input"
                        {% if uuid is same as(value) %} checked{% endif %}
                    />
                    <label for="{{ familyLog.vars.id ~ key }}"{% if children == 1 %}class="accordion_label" {% endif %}>{{ label }}</label>
                    {% set key = key + 1 %}
            {% if children == 1 %}
                <ul class="accordion_child">
            {% elseif children == 0 %}
                    </li>
                </ul>
            {% endif %}
            {% set previousLevel = level %}
        {% endfor %}
    </ul>

</div>
{{ form_help(familyLog) }}
