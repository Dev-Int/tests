<div class="flex-1">

    <h3>{{ 'admin.tax.create.titlePage'|trans }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.name) }}
    {{ form_row(form.rate) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_taxes_index') }}" label="{{ 'cancel'|trans }}" turboFrame="_top" />
        <twig:Form:Button:Submit label="{{ 'add'|trans }}" icon="fa-plus" />
    </div>

    {{ form_end(form) }}

</div>
