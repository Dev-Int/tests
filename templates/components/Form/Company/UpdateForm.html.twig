<div class="flex-1">

    <h3>Update "{{ companyName }}"</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.address) }}
    <div class="grid">
        {{ form_row(form.postalCode) }}
        {{ form_row(form.town) }}
    </div>
    {{ form_row(form.country) }}
    <div class="grid">
        {{ form_row(form.phone) }}
        {{ form_row(form.email) }}
    </div>
    {{ form_row(form.contact) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_company_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Update" />
    </div>

    {{ form_end(form) }}

</div>
