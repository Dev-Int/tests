<div class="flex-1">

    <h3>{{ 'admin.familyLog.assignParent.titlePage'|trans({ '%familyLabel%':familyLog.label }) }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.parent}) }}
    {{ form_row(form.uuid) }}


    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_family_logs_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="{{ 'admin.familyLog.assignParent.button'|trans }}" />
    </div>

    {{ form_end(form) }}

</div>
