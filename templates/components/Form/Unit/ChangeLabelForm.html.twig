<div class="flex-1">

    <h3>{{ 'admin.unit.changeLabel.titlePage'|trans({ '%unitName%':unit.label }) }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.label) }}
    {{ form_row(form.abbreviation) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_units_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="{{ 'admin.unit.changeLabel.button'|trans }}" icon="fa-pen-to-square" />
    </div>

    {{ form_end(form) }}

</div>
