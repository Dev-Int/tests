<div class="flex-1">

    <h3>{{ 'admin.article.reassignSupplier.titlePage'|trans({ '%articleName%': article.name }) }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.supplier) }}

    <div class="grid">
        {{ form_row(form.zoneStorages) }}
        {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.familyLog}) }}
    </div>

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_articles_index') }}" label="{{ 'cancel'|trans }}" turboFrame="_top" />
        <twig:Form:Button:Submit label="{{ 'admin.article.reassignSupplier.button'|trans }}" icon="fa-pen-to-square" />
    </div>

    {{ form_end(form) }}

</div>
