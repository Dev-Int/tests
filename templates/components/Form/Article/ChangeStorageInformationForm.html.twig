<div class="flex-1">

    <h3>{{ 'admin.article.changeStorageInformation.titlePage'|trans({ '%articleName%': article.name }) }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ include('partials/components/form/_packaging-select.html.twig', {packaging: form.packaging}) }}

    {{ form_row(form.minStock) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_articles_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="{{ 'admin.article.changeStorageInformation.button'|trans }}" icon="fa-pen-to-square" />
    </div>

    {{ form_end(form) }}

</div>
