<div {{ attributes }} id="pagination">
    {% set url = app.current_route %}
    {% set param = app.current_route_parameters %}

    {% if totalPages > 1 %}
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link{% if page == 1 %} disable-link{% endif %}" href="{{ path(url, {page: 1, itemsPerPage: itemsPerPage}) }}" aria-label="First">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link{% if page - 1 == 0 %} disable-link{% endif %}" href="{{ path(url, {page: (page - 1), itemsPerPage: itemsPerPage}) }}" aria-label="Previous">
                        <span aria-hidden="true">&lt;</span>
                    </a>
                </li>
                {% if page - 1 != 0 %}
                    <li class="page-item"><a class="page-link" href="{{ path(url, {page: page - 1}) }}">{{ page - 1 }}</a></li>
                {% endif %}
                <li class="page-item"><a class="page-link active" aria-current="page" href="{{ path(url, {page: page, itemsPerPage: itemsPerPage}) }}">{{ page }}</a></li>
                {% if page + 1 <= totalPages %}
                    <li class="page-item"><a class="page-link" href="{{ path(url, {page: (page + 1), itemsPerPage: itemsPerPage}) }}">{{ page + 1 }}</a></li>
                {% endif %}
                {% if page + 2 != totalPages and page + 2 < totalPages  %}
                    <li class="page-item"><a class="page-link" href="{{ path(url, {page: (page + 2), itemsPerPage: itemsPerPage}) }}">{{ page + 2 }}</a></li>
                {% endif %}
                {% if totalPages > page + 3  %}
                    <li class="page-item"><a class="page-link disable-link">...</a></li>
                {% endif %}
                {% if totalPages > page + 2 %}
                    <li class="page-item"><a class="page-link" href="{{ path(url, {page: (totalPages), itemsPerPage: itemsPerPage}) }}">{{ totalPages }}</a></li>
                {% endif %}
                <li class="page-item">
                    <a class="page-link{% if page + 1 > totalPages %} disable-link{% endif %}" href="{{ path(url, {page: (page + 1), itemsPerPage: itemsPerPage}) }}" aria-label="Next">
                        <span aria-hidden="true">&gt;</span>
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link{% if page == totalPages %} disable-link{% endif %}" href="{{ path(url, {page: totalPages, itemsPerPage: itemsPerPage}) }}" aria-label="Last">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>

        <form class="items-per-page grid" method="get" name="paginate">
            <input name="page" type="hidden" value="{{ page }}">
            <label>Items per page :
                <select name="itemsPerPage" data-model="on(change)|itemsPerPage">
                    <option value="25" {% if itemsPerPage == 25 %}selected{% endif %}>25</option>
                    {% if (totalPages * itemsPerPage) >= 50  %}<option value="50" {% if itemsPerPage == 50 %}selected{% endif %}>50</option>{% endif %}
                    {% if (totalPages * itemsPerPage) >= 100  %}<option value="100" {% if itemsPerPage == 100 %}selected{% endif %}>100</option>{% endif %}
                </select>
            </label>
            <button class="btn-small"
                data-action="live#action"
                data-live-action-param="paginate"
            ><i class="fas fa-list"></i> {{ 'paginate'|trans }}</button>
        </form>
    {% endif %}

</div>
