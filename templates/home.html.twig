            <dd>{{ 'home.text.4.text'|trans }}</dd>
            <dt>{{ 'home.text.5.title'|trans }}</dt>
            <dd>{{ 'home.text.5.text'|trans }}</dd>
            <dt>{{ 'home.text.6.title'|trans }}</dt>
            <dd>{{ 'home.text.6.text'|trans }}</dd>
            <dt>{{ 'home.text.7.title'|trans }}</dt>
            <dd>{{ 'home.text.7.text'|trans }}</dd>
            <dt>{{ 'home.text.8.title'|trans }}</dt>
            <dd>{{ 'home.text.8.text'|trans }}</dd>
        </dl>

        <p>{{ 'home.text.conclusion'|trans }}</p>
    </article>
{% endblock %}
