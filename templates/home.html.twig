            <dt>{{ 'home.text.2.title'|trans }}</dt>
            <dd>{{ 'home.text.2.text'|trans }}</dd>
            <dt>{{ 'home.text.3.title'|trans }}</dt>
            <dd>{{ 'home.text.3.text'|trans }}</dd>
