{% extends 'base.html.twig' %}

{% block title %}
    Update Tax | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Taxe /> Rename Tax "{{ tax.name }}"</h1>

    <turbo-frame id="tax_{{ tax.uuid }}">
        <h2>Rename Tax "{{ tax.name }}"</h2>

        <twig:Form:Taxes:RenameForm form="{{ form }}" />
    </turbo-frame>

{% endblock %}

