{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.tax.rename.titlePage'|trans({ '%taxName%':tax.name }) }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Tax /> {{ 'admin.tax.rename.titlePage'|trans({ '%taxName%':tax.name }) }}</h1>

    <turbo-frame id="tax_{{ tax.uuid }}">
        <twig:Form:Taxes:RenameForm form="{{ form }}" tax="{{ tax }}" initialFormData="{{ form.vars.value }}" />
    </turbo-frame>

{% endblock %}
