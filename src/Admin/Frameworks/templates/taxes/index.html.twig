{% extends 'base.html.twig' %}

{% block title %}
    Taxes | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fas fa-percent"></i> Taxes</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><a href="{{ path('admin_taxes_create') }}" class="w100" role="button">Create Tax</a></li>
                    <li>
                        {{ include('partials/components/_back-home-button.html.twig') }}
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {%  for tax in taxes %}
                <li class="li-unstyled flex-between">
                    {{ tax.name }} {{ tax.rate }}
                    <span>
                        <a href="{{ path('admin_taxes_rename', {'uuid': tax.uuid}) }}" role="button">Rename tax</a>
                        <a href="{{ path('admin_taxes_revaluate', {'uuid': tax.uuid}) }}" role="button">Reevaluate tax</a>
                    </span>
                </li>
                {% endfor %}
            </ul>
        </article>
    </div>

{% endblock %}
