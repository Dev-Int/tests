{% extends 'base.html.twig' %}

{% block title %}
    Taxes | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Taxe /> Taxes</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><twig:Button:CreateEntity href="{{ path('admin_taxes_create') }}" class="w100" label="Create Tax" /></li>
                    <li><twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" /></li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {%  for tax in taxes %}
                    <turbo-frame id="tax_{{ tax.uuid }}">
                        <li class="li-unstyled flex-between">
                            {{ tax.name }} {{ tax.rate }}
                            <span>
                                <twig:Button:UpdateEntity href="{{ path('admin_taxes_rename', {'tax': tax.uuid}) }}" label="Rename tax" />
                                <twig:Button:UpdateEntity href="{{ path('admin_taxes_revaluate', {'tax': tax.uuid}) }}" label="Revaluate tax" />
                            </span>
                        </li>
                    </turbo-frame>
                {% endfor %}
            </ul>
        </article>
    </div>

{% endblock %}
