{% extends 'base.html.twig' %}

{% block title %}
    Update Tax | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Taxe /> Revaluate Tax "{{ tax.name }}"</h1>

    <turbo-frame id="tax_{{ tax.uuid }}">
        <twig:Form:Taxes:RevaluateForm form="{{ form }}" tax="{{ tax }}" />
    </turbo-frame>

{% endblock %}
