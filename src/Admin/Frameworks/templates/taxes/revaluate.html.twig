{% extends 'base.html.twig' %}

{% block title %}
    Update Tax | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Taxe /> Revaluate Tax "{{ tax.name }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.rate) }}
    {{  form_row(form.uuid) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_taxes_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Revaluate" />
    </div>

    {{ form_end(form) }}

{% endblock %}

