<div class="flex-1">

    <h3>{{ 'admin.employee.create.titlePage'|trans }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="grid">
        {{ form_row(form.firstName) }}
        {{ form_row(form.lastName) }}
    </div>

    <div class="grid">
        {{ form_row(form.email) }}
        {{ form_row(form.phone) }}
    </div>

    <div class="grid">
        {{ form_row(form.position) }}
        {{ form_row(form.department) }}
    </div>

    {{ form_row(form.hiredAt) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_employees_index') }}" label="{{ 'cancel'|trans }}" turboFrame="_top" />
        <twig:Form:Button:Submit label="{{ 'add'|trans }}" icon="fa-plus" />
    </div>

    {{ form_end(form) }}

</div>
