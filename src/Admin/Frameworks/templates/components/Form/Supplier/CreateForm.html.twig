<div class="flex-1">

    <h3>{{ 'admin.supplier.create.titlePage'|trans }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.name) }}
    {{ form_row(form.streetAddress) }}
    <div class="grid">
        {{ form_row(form.postalCode) }}
        {{ form_row(form.city) }}
        {{ form_row(form.country) }}
    </div>
    <div class="grid">
        {{ form_row(form.phone) }}
        {{ form_row(form.email) }}
    </div>
    <div class="grid">
        {{ form_row(form.contact) }}
        {{ form_row(form.cellphone) }}
    </div>

    <div class="grid">
        {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.familyLog}) }}
        <div>
            {{ form_row(form.delayDelivery, {'attr': {'class': 'w50'}}) }}
            {{ form_row(form.orderDays) }}
        </div>
    </div>

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_suppliers_index') }}" label="{{ 'cancel'|trans }}" turboFrame="_top" />
        <twig:Form:Button:Submit label="{{ 'add'|trans }}" icon="fa-plus" />
    </div>

    {{ form_end(form) }}

</div>
