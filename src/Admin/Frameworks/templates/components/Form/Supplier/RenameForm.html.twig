<div class="flex-1">

    <h3>{{ 'admin.supplier.rename.titlePage'|trans({ '%supplierName%': supplier.name }) }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.name) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_suppliers_index') }}" label="{{ 'cancel'|trans }}" turboFrame="_top" />
        <twig:Form:Button:Submit label="{{ 'admin.supplier.rename.button'|trans }}" icon="fa-pen-to-square" />
    </div>

    {{ form_end(form) }}

</div>
