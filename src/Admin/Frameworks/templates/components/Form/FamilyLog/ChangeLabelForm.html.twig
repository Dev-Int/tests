<div class="flex-1">

    <h3>{{ 'admin.familyLog.changeLabel.titlePage'|trans({ '%familyLabel%': familyLog.label }) }}</h3>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.label) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_family_logs_index') }}" label="{{ 'cancel'|trans }}" turboFrame="_top" />
        <twig:Form:Button:Submit label="{{ 'admin.familyLog.changeLabel.button'|trans }}" icon="fa-pen-to-square" />
    </div>

    {{ form_end(form) }}

</div>
