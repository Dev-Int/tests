{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.article.reassignSupplier.titleShort'|trans({ '%articleName%': article.name }) }} | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> {{ 'admin.article.reassignSupplier.titlePage'|trans({ '%articleName%': article.name }) }}</h1>

    <turbo-frame id="article_{{ article.uuid }}">
        <twig:Form:Article:ReassignSupplierForm form="{{ form }}" article="{{ article }}" />
    </turbo-frame>

{% endblock %}

