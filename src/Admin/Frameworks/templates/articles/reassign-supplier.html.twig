{% extends 'base.html.twig' %}

{% block title %}
    ReAssign supplier Article | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> Re-assign supplier to "{{ article.name }}"</h1>

    <turbo-frame id="article_{{ article.uuid }}">
        <h2>Re-assign supplier to "{{ article.name }}"</h2>

        <twig:Form:Article:ReassignSupplierForm form="{{ form }}" />
    </turbo-frame>

{% endblock %}

