{% extends 'base.html.twig' %}

{% block title %}
    Articles | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> Articles</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><twig:Button:CreateEntity href="{{ path('admin_article_create') }}" label="Create Article" class="w100" /></li>
                    <li><twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" /></li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for article in articles %}
                <li class="li-unstyled flex-between">
                    {{ article.name }}
                    <span>
                        <twig:Button:UpdateEntity href="{{ path('admin_articles_rename', {'article': article.uuid}) }}" label="Rename" />
                        <twig:Button:UpdateEntity href="{{ path('admin_articles_reassign-supplier', {'article': article.uuid}) }}" label="Supplier" />
                        <twig:Button:UpdateEntity href="{{ path('admin_articles_change-storage-information', {'article': article.uuid}) }}" label="Storage information" />
                        <twig:Button:UpdateEntity href="{{ path('admin_articles_change_financial-information', {'article': article.uuid}) }}" label="Financial information" />
                    </span>
                </li>
                {%  endfor %}
            </ul>
        </article>
    </div>

{% endblock %}
