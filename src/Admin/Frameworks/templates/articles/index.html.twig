{% extends 'base.html.twig' %}

{% block title %}
    Articles | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','pagination']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> Articles</h1>

    <main>
        <article>
            <div>
                <turbo-frame id="article_create" class="flex-between">
                    <span></span>
                    <twig:Button:CreateEntity href="{{ path('admin_article_create') }}" label="{{ 'admin.article.create.titleShort'|trans }}" />
                </turbo-frame>
            </div>
            <turbo-frame id="article_paginated">
                <ul class="table">
                    <li class="li-unstyled flex-between head">
                        <span>{{ 'name'|trans }}</span>
                        <span>{{ 'admin.article.form.supplier.label'|trans }}</span>
                        <span>{{ 'actions'|trans }}</span>
                    </li>
                    {% for article in articles %}
                        <turbo-frame id="article_{{ article.uuid }}">
                            <li class="li-unstyled flex-between">
                                <span>{{ article.name }}</span>
                                <span>{{ article.supplier.name }}</span>
                                <span>
                                    <twig:Button:UpdateEntity
                                        href="{{ path('admin_articles_rename', {'article': article.uuid}) }}"
                                        class="btn-small"
                                        label="{{ 'admin.article.rename.button'|trans }}"/>
                                    <twig:Button:UpdateEntity
                                        href="{{ path('admin_articles_reassign-supplier', {'article': article.uuid}) }}"
                                        class="btn-small"
                                        label="{{ 'admin.article.reassignSupplier.button'|trans }}"
                                    />
                                    <twig:Button:UpdateEntity
                                        href="{{ path('admin_articles_change-storage-information', {'article': article.uuid}) }}"
                                        class="btn-small"
                                        label="{{ 'admin.article.changeStorageInformation.button'|trans }}"
                                    />
                                    <twig:Button:UpdateEntity
                                        href="{{ path('admin_articles_change_financial-information', {'article': article.uuid}) }}"
                                        class="btn-small"
                                        label="{{ 'admin.article.changeFinancialInformation.button'|trans }}"
                                    />
                                </span>
                            </li>
                        </turbo-frame>
                    {%  endfor %}
                </ul>

                <twig:Pagination page="{{ pagination.page }}" itemsPerPage="{{ pagination.itemsPerPage }}" totalPages="{{ pagination.totalPages }}" />
            </turbo-frame>
            <twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" />
        </article>
    </main>

{% endblock %}
