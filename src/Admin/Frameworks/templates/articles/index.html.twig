{% extends 'base.html.twig' %}

{% block title %}
    Articles | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fa-solid fa-plate-wheat"></i> Articles</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><a href="{{ path('admin_article_create') }}" class="w100" role="button">Create Article</a></li>
                    <li>
                        {{ include('@admin/partials/components/_back-admin-button.html.twig') }}
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for article in articles %}
                <li class="li-unstyled flex-between">
                    {{ article.name }}
                    <span>
                        <a href="{{ path('admin_articles_rename', {'article': article.uuid}) }}" role="button">Rename</a>
                        <a href="{{ path('admin_articles_reassign-supplier', {'article': article.uuid}) }}" role="button">Re-assign Supplier</a>
                        <a href="{{ path('admin_articles_change-storage-information', {'article': article.uuid}) }}" role="button">Change storage information</a>
                        <a href="{{ path('admin_articles_change_financial-information', {'article': article.uuid}) }}" role="button">Change financial information</a>
                    </span>
                </li>
                {%  endfor %}
            </ul>
        </article>
    </div>

{% endblock %}
