{% extends 'base.html.twig' %}

{% block title %}
    Change financial information Article | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> Change financial information to "{{ article.name }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.amount) }}
    {{ form_row(form.tax) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_articles_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Update" />
    </div>

    {{ form_end(form) }}

{% endblock %}

