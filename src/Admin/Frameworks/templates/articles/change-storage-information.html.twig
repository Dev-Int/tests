{% extends 'base.html.twig' %}

{% block title %}
    Change storage information Article | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> Change storage information to "{{ article.name }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ include('partials/components/form/_packaging-select.html.twig', {packaging: form.packaging}) }}

    {{ form_row(form.minStock) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_articles_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Update" />
    </div>

    {{ form_end(form) }}

{% endblock %}
