{% extends 'base.html.twig' %}

{% block title %}
    Change storage information Article | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> Change storage information to "{{ article.name }}"</h1>

    <turbo-frame id="article_{{ article.uuid }}">
        <twig:Form:Article:ChangeStorageInformationForm form="{{ form }}" article="{{ article }}" />
    </turbo-frame>

{% endblock %}
