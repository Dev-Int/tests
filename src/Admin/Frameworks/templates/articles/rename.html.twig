{% extends 'base.html.twig' %}

{% block title %}
    Rename article | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fa-solid"></i> Rename "{{ article.name }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.name) }}

    <div class="grid"><a href="{{ path('admin_articles_index') }}" class="secondary" role="button">Annuler</a>
        <button type="submit">Rename</button>
    </div>

    {{ form_end(form) }}

{% endblock %}

