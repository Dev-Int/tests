{% extends 'base.html.twig' %}

{% block title %}
    Rename article | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Article /> Rename "{{ article.name }}"</h1>

    <turbo-frame id="article_{{ article.uuid }}">
        <twig:Form:Article:RenameForm form="{{ form }}" article="{{ article }}" />
    </turbo-frame>

{% endblock %}

