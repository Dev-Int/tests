{% extends 'base.html.twig' %}

{% block title %}
    Create Unit | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Unit /> Create Unit</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.label) }}
    {{ form_row(form.abbreviation) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_units_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Create" />
    </div>

    {{ form_end(form) }}

{% endblock %}
