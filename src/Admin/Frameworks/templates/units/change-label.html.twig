{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.unit.changeLabel.titleShort'|trans({ '%unitName%':unit.label }) }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Unit /> {{ 'admin.unit.changeLabel.titlePage'|trans({ '%unitName%':unit.label }) }}</h1>

    <turbo-frame id="unit_{{ unit.uuid }}">
        <twig:Form:Unit:ChangeLabelForm form="{{ form }}" unit="{{ unit }}" initialFormData="{{ form.vars.value }}" />
    </turbo-frame>

{% endblock %}

