{% extends 'base.html.twig' %}

{% block title %}
    Update Unit | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fas fa-flask"></i> Change label "{{ unit.label }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.label) }}
    {{ form_row(form.abbreviation) }}

    <div class="grid">
        <a href="{{ path('admin_units_index') }}" class="secondary" role="button">Annuler</a>
        <button type="submit">Change label</button>
    </div>

    {{ form_end(form) }}

{% endblock %}

