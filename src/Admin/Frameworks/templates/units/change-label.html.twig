{% extends 'base.html.twig' %}

{% block title %}
    Update Unit | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Unit /> Change label "{{ unit.label }}"</h1>

    <turbo-frame id="unit_{{ unit.uuid }}">
        <h2>Change label {{ unit.slug }}</h2>

        <twig:Form:Unit:ChangeLabelForm form="{{ form }}" />
    </turbo-frame>

{% endblock %}

