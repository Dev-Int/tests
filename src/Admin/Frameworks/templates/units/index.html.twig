{% extends 'base.html.twig' %}

{% block title %}
    Units | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Unit /> Units</h1>

    <main>
        <article>
            <div>
                <turbo-frame id="unit_create" class="flex-between">
                    <span></span>
                    <twig:Button:CreateEntity href="{{ path('admin_unit_create') }}" label="Create Unit" />
                </turbo-frame>
            </div>
            <ul class="table">
                <li class="li-unstyled flex-between head">
                    <span>Label</span>
                    <span>Abbreviation</span>
                    <span>Action</span>
                </li>
                {% for unit in units %}
                    <turbo-frame id="unit_{{ unit.uuid }}">
                        <li class="li-unstyled flex-between">
                            <span>{{ unit.label }}</span>
                            <span>{{ unit.abbreviation }}</span>
                            <span>
                                <twig:Button:UpdateEntity href="{{ path('admin_units_change-label', {unit: unit.uuid}) }}" class="btn-small" label="Change label"/>
                            </span>
                        </li>
                    </turbo-frame>
                {% endfor %}
            </ul>
            <twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" />
        </article>
    </main>

{% endblock %}

