{% extends 'base.html.twig' %}

{% block title %}
    Units | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Unit /> Units</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><twig:Button:CreateEntity href="{{ path('admin_unit_create') }}" class="w100" label="Create Unit" /></li>
                    <li><twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" /></li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for unit in units %}
                    <turbo-frame id="unit_{{ unit.uuid }}">
                        <li class="li-unstyled flex-between">
                            {{ unit.label }} {{ unit.abbreviation }}
                            <span>
                                <twig:Button:UpdateEntity href="{{ path('admin_units_change-label', {unit: unit.uuid}) }}" label="Change label"/>
                            </span>
                        </li>
                    </turbo-frame>
                {% endfor %}
            </ul>
        </article>
    </div>

{% endblock %}

