{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.unit.titlePage'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Unit /> {{ 'admin.unit.titlePage'|trans }}</h1>

    <main>
        <article>
            <div>
                <turbo-frame id="unit_create" class="flex-between">
                    <span></span>
                    <twig:Button:CreateEntity
                        href="{{ path('admin_unit_create') }}"
                        label="{{ 'admin.unit.create.titleShort'|trans }}"
                    />
                </turbo-frame>
            </div>
            <ul class="table">
                <li class="li-unstyled flex-between head">
                    <span>{{ 'admin.unit.form.label.label'|trans }}</span>
                    <span>{{ 'admin.unit.form.abbreviation.label'|trans }}</span>
                    <span>{{ 'actions'|trans }}</span>
                </li>
                {% for unit in units %}
                    <turbo-frame id="unit_{{ unit.uuid }}">
                        <li class="li-unstyled flex-between">
                            <span>{{ unit.label }}</span>
                            <span>{{ unit.abbreviation }}</span>
                            <span>
                                <twig:Button:UpdateEntity
                                    href="{{ path('admin_units_change-label', {unit: unit.uuid}) }}"
                                    class="btn-small"
                                    label="{{ 'admin.unit.changeLabel.button'|trans }}"
                                />
                            </span>
                        </li>
                    </turbo-frame>
                {% endfor %}
            </ul>
            <twig:Button:BackTo href="{{ path('admin_index') }}" label="{{ 'admin.adminButton'|trans }}" />
        </article>
    </main>

{% endblock %}

