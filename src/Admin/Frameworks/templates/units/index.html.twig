{% extends 'base.html.twig' %}

{% block body %}

    <h1><i class="fas fa-flask"></i> Units</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><a href="{{ path('admin_unit_create') }}" class="w100" role="button">Create Unit</a></li>
                    <li>
                        {{ include('partials/components/_back-home-button.html.twig') }}
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for unit in units %}
                <li class="li-unstyled flex-between">
                    {{ unit.label }} {{ unit.abbreviation }}
                    <span>
                        <a href="{{ path('admin_units_change-label', {slug: unit.slug}) }}" role="button">Change label</a>
                    </span>
                </li>
                {% endfor %}
            </ul>
        </article>
    </div>

{% endblock %}

