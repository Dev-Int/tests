{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.configuration.application.titlePage'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fa fa-cogs"></i> {{ 'admin.configuration.application.titlePage'|trans }}</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav id="menu">
                <ul>
                    <li>
                        <a href="{{ path('admin_unit_create') }}" class="{% if hasUnit %}secondary disable-link {% endif %}w100" role="button">
                            {% if hasUnit %}<i class="fa-solid fa-square-check"></i>
                            {% else %}<twig:Icon:Entities:Unit />{% endif%} {{ 'admin.unit.create.titleShort'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_taxes_create') }}" class="{% if hasTaxe %}secondary disable-link {% endif %}w100" role="button">
                            {% if hasTaxe %}<i class="fa-solid fa-square-check"></i>
                            {% else %}<twig:Icon:Entities:Tax />{% endif%} {{ 'admin.tax.create.titleShort'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="#" class="secondary disable-link w100" role="button">
                            <twig:Icon:Check />&nbsp;
                        </a>
                    </li>
                    <li>
                        <a href="#" class="secondary disable-link w100" role="button">
                            <twig:Icon:Check />&nbsp;
                        </a>
                    </li>
                    <li>
                        <a href="#" class="secondary disable-link w100" role="button">
                            <twig:Icon:Check />&nbsp;
                        </a>
                    </li>
                    <li>
                        <a href="#" class="secondary disable-link w100" role="button">
                            <twig:Icon:Check />&nbsp;
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            {{ 'admin.configuration.application.resume'|trans|raw }}

            <p class="bottom-element">
                <a href="{{ path('admin_configure') }}" role="button">
                    <i class="fa-solid fa-angles-left"></i> {{ 'admin.configuration.application.returnButton'|trans }}
                </a>
            </p>
        </article>
    </div>

{% endblock %}
