{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.employee.index.titlePage'|trans }} | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'pagination']) }}
{% endblock %}

{% block body %}

    <h1><i class="fa fa-users"></i> {{ 'admin.employee.index.titlePage'|trans }}</h1>

    <main>
        <article>
            <div>
                <turbo-frame id="employee_create" class="flex-between">
                    <span></span>
                    <twig:Button:CreateEntity href="{{ path('admin_employees_create') }}" label="{{ 'admin.employee.create.titleShort'|trans }}" />
                </turbo-frame>
            </div>

            <turbo-frame id="employee_paginated">
                <ul class="table">
                    <li class="li-unstyled flex-between head">
                        <span>{{ 'admin.employee.index.table.firstName'|trans }}</span>
                        <span>{{ 'admin.employee.index.table.lastName'|trans }}</span>
                        <span>{{ 'admin.employee.index.table.email'|trans }}</span>
                        <span>{{ 'admin.employee.index.table.phone'|trans }}</span>
                        <span>{{ 'admin.employee.index.table.position'|trans }}</span>
                        <span>{{ 'admin.employee.index.table.department'|trans }}</span>
                        <span>{{ 'admin.employee.index.table.status'|trans }}</span>
                        <span>{{ 'admin.employee.index.table.hiredAt'|trans }}</span>
                        <span>{{ 'actions'|trans }}</span>
                    </li>
                    {% if employees|length == 0 %}
                        <p>{{ 'admin.employee.index.noEmployee'|trans }}</p>
                    {% endif %}
                    {% for employee in employees %}
                        <turbo-frame id="employee_{{ employee.uuid.toString }}">
                            <li class="li-unstyled flex-between">
                                <span>{{ employee.firstName.toString }}</span>
                                <span>{{ employee.lastName.toString }}</span>
                                <span>{{ employee.contactInformation.email.toString }}</span>
                                <span>{{ employee.contactInformation.phone.toNumber }}</span>
                                <span>{{ employee.position.toString }}</span>
                                <span>{{ employee.department.toString }}</span>
                                <span>
                                    {% if employee.isActive %}
                                        <span class="badge badge-success">{{ 'admin.employee.status.active'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge-secondary">{{ 'admin.employee.status.inactive'|trans }}</span>
                                    {% endif %}
                                </span>
                                <span>{{ employee.hiredAt|date('d/m/Y') }}</span>
                                <span>
                                    <twig:Button:UpdateEntity
                                        href="{{ path('admin_employees_update', {employee: employee.uuid.toString}) }}"
                                        class="btn-small"
                                        label="{{ 'admin.employee.update.titleShort'|trans }}" />
                                    {% if employee.isActive %}
                                        <form action="{{ path('admin_employees_disable', {employee: employee.uuid.toString}) }}" method="post" style="display:inline;" onsubmit="return confirm('{{ 'Êtes-vous sûr de vouloir désactiver cet employé ?'|trans }}');">
                                            <button type="submit" class="btn btn-small btn-error">
                                                <i class="fa fa-ban"></i> {{ 'admin.employee.disable.button'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </span>
                            </li>
                        </turbo-frame>
                    {% endfor %}
                </ul>

                <twig:Pagination
                    page="{{ pagination.page }}"
                    itemsPerPage="{{ pagination.itemsPerPage }}"
                    totalPages="{{ pagination.totalPages }}"
                    route="admin_employees_index"
                />
            </turbo-frame>

        </article>
    </main>

{% endblock %}
