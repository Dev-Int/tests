{% extends 'base.html.twig' %}

{% block title %}
    ZoneStorages | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fa-solid fa-warehouse"></i> Storage Zones</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><a href="{{ path('admin_zone_storages_create') }}" class="w100" role="button">Create ZoneStorage</a></li>
                    <li>
                        {{ include('@admin/partials/components/_back-admin-button.html.twig') }}
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for zone in zoneStorages %}
                <li class="li-unstyled flex-between">
                    {{ zone.label }}&nbsp;
                    <span>
                        <a href="{{ path('admin_zone_storages_change-label', {slug: zone.slug}) }}" role="button">Change label</a>
                        <a href="{{ path('admin_zone_storages_change-family_log', {slug: zone.slug}) }}" role="button">Change familyLog</a>
                    </span>
                </li>
                {% endfor %}
            </ul>
        </article>
    </div>

{% endblock %}
