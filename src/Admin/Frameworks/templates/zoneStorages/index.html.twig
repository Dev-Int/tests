{% extends 'base.html.twig' %}

{% block title %}
    ZoneStorages | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:ZoneStorage /> Storage Zones</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><twig:Button:CreateEntity href="{{ path('admin_zone_storages_create') }}" class="w100" label="Create ZoneStorage" /></li>
                    <li><twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" /></li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for zone in zoneStorages %}
                    <turbo-frame id="zone_{{ zone.uuid }}">
                        <li class="li-unstyled flex-between">
                            {{ zone.label }}&nbsp;
                            <span>
                        <twig:Button:UpdateEntity
                            href="{{ path('admin_zone_storages_change-label', {zoneStorage: zone.uuid}) }}" label="Change label"/>
                        <twig:Button:UpdateEntity
                            href="{{ path('admin_zone_storages_change-family_log', {zoneStorage: zone.uuid}) }}" label="Change familyLog"/>
                    </span>
                        </li>
                    </turbo-frame>
                {% endfor %}
            </ul>
        </article>
    </div>

{% endblock %}
