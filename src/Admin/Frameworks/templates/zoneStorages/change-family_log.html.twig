{% extends 'base.html.twig' %}

{% block title %}
    Update ZoneStorage | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:ZoneStorage /> Change FamilyLog "{{ zoneStorage.label }}"</h1>

    <turbo-frame id="zone_{{ zoneStorage.uuid }}">
        <twig:Form:ZoneStorage:ChangeFamilyLogForm form="{{ form }}" zoneStorage="{{ zoneStorage }}" />
    </turbo-frame>
{% endblock %}

