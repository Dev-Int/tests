{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.zoneStorage.changeFamilyLog.titleShort'|trans }} | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:ZoneStorage /> {{ 'admin.zoneStorage.changeFamilyLog.titlePage'|trans({ '%zoneLabel%': zoneStorage.label }) }}</h1>

    <turbo-frame id="zone_{{ zoneStorage.uuid }}">
        <twig:Form:ZoneStorage:ChangeFamilyLogForm form="{{ form }}" zoneStorage="{{ zoneStorage }}" initialFormData="{{ form.vars.value }}" />
    </turbo-frame>
{% endblock %}

