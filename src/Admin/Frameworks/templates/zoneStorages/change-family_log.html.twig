{% extends 'base.html.twig' %}

{% block title %}
    Update ZoneStorage | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><i class="fa-solid fa-warehouse"></i> Change FamilyLog "{{ zoneStorage.label }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.familyLog}) }}

    <div class="grid">
        <a role="button" href="{{ path('admin_zone_storages_index') }}" class="secondary">Annuler</a>
        <button type="submit">Change FamilyLog</button>
    </div>

    {{ form_end(form) }}

{% endblock %}

