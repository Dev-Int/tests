{% extends 'base.html.twig' %}

{% block title %}
    Update ZoneStorage | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:ZoneStorage /> Change FamilyLog "{{ zoneStorage.label }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.familyLog}) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_zone_storages_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Change FamilyLog" />
    </div>

    {{ form_end(form) }}

{% endblock %}

