{% extends 'base.html.twig' %}

{% block title %}
    Update ZoneStorage | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:ZoneStorage /> Change label "{{ zoneStorage.label }}"</h1>

    <turbo-frame id="zone_{{ zoneStorage.uuid }}">
        <twig:Form:ZoneStorage:ChangeLabelForm form="{{ form }}" zoneStorage="{{ zoneStorage }}" />
    </turbo-frame>

{% endblock %}

