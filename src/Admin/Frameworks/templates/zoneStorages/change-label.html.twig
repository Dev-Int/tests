{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.zoneStorage.changeLabel.titleShort'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:ZoneStorage /> {{ 'admin.zoneStorage.changeLabel.titlePage'|trans({ '%zoneLabel%': zoneStorage.label }) }}</h1>

    <turbo-frame id="zone_{{ zoneStorage.uuid }}">
        <twig:Form:ZoneStorage:ChangeLabelForm form="{{ form }}" zoneStorage="{{ zoneStorage }}" initialFormData="{{ form.vars.value }}" />
    </turbo-frame>

{% endblock %}

