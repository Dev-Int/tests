{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.familyLog.titlePage'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:FamilyLog /> {{ 'admin.familyLog.titlePage'|trans }}</h1>

    <main>
        <article>
            <div>
                <turbo-frame id="familyLog_create" class="flex-between">
                    <span></span>
                    <twig:Button:CreateEntity
                        href="{{ path('admin_family_logs_create') }}"
                        label="{{ 'admin.familyLog.create.titleShort'|trans }}"
                    />
                </turbo-frame>
            </div>

            <ul class="table">
                <li class="li-unstyled flex-between head">
                    <span>Path</span>
                    <span>Action</span>
                </li>
                {% for family in familyLogs %}
                    <turbo-frame id="familyLog_{{ family.uuid }}">
                        <li class="li-unstyled flex-between">
                            <span>{{ family.path }}&nbsp;</span>
                            <span>
                                <twig:Button:UpdateEntity
                                    href="{{ path('admin_family_logs_change-label', {familyLog: family.uuid}) }}"
                                    class="btn-small"
                                    label="{{ 'admin.familyLog.changeLabel.button'|trans }}"
                                />
                                <twig:Button:UpdateEntity
                                    href="{{ path('admin_family_logs_assign-parent', {familyLog: family.uuid}) }}"
                                    class="btn-small"
                                    label="{{ 'admin.familyLog.assignParent.button'|trans }}"
                                />
                            </span>
                        </li>
                    </turbo-frame>
                {% endfor %}
            </ul>
            <twig:Button:BackTo href="{{ path('admin_index') }}" label="{{ 'admin.adminButton'|trans }}" />
        </article>
    </main>
{% endblock %}
