{% extends 'base.html.twig' %}

{% block title %}
    FamilyLogs | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:FamilyLog /> Logistics Families</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><twig:Button:CreateEntity href="{{ path('admin_family_logs_create') }}" label="Create FamilyLog" /></li>
                    <li><twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" /></li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for family in familyLogs %}
                    <turbo-frame id="familyLog_{{ family.uuid }}">
                        <li class="li-unstyled flex-between">
                            {{ family.path }}&nbsp;
                            <span>
                                <twig:Button:UpdateEntity href="{{ path('admin_family_logs_change-label', {familyLog: family.uuid}) }}" label="Change label" />
                                <twig:Button:UpdateEntity href="{{ path('admin_family_logs_assign-parent', {familyLog: family.uuid}) }}" label="Assign parent" />
                            </span>
                        </li>
                    </turbo-frame>
                {% endfor %}
            </ul>
        </article>
    </div>
{% endblock %}
