{% extends 'base.html.twig' %}

{% block title %}
    FamilyLogs | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fas fa-tags"></i> Logistics Families</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><a href="{{ path('admin_family_logs_create') }}" class="w100" role="button">Create FamilyLog</a></li>
                    <li>
                        {{ include('partials/components/_back-home-button.html.twig') }}
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for family in familyLogs %}
                    <li class="li-unstyled flex-between">
                        {{ family.path }}&nbsp;
                        <span>
                            <a href="{{ path('admin_family_logs_change-label', {uuid: family.uuid}) }}" role="button">
                                Change label
                            </a>&nbsp;
                            <a href="{{ path('admin_family_logs_assign-parent', {uuid: family.uuid}) }}" role="button">
                                Assign parent
                            </a>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </article>
    </div>
{% endblock %}
