{% extends 'base.html.twig' %}

{% block title %}
    Create FamilyLog | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><i class="fas fa-tags"></i> Create Logistic Family</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.label) }}

    {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.parent}) }}

    <div class="grid">
        <a role="button" href="{{ path('admin_family_logs_index') }}" class="secondary">Annuler</a>
        <button type="submit">Create</button>
    </div>

    {{ form_end(form) }}

{% endblock %}
