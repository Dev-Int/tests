{% extends 'base.html.twig' %}

{% block title %}
    Create FamilyLog | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:FamilyLog /> Create Logistic Family</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.label) }}

    {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.parent}) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_family_logs_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Create" />
    </div>

    {{ form_end(form) }}

{% endblock %}
