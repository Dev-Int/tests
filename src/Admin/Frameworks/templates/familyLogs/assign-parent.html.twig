{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.familyLog.assignParent.titleShort'|trans }} | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}
    <h1><twig:Icon:Entities:FamilyLog /> {{ 'admin.familyLog.assignParent.titlePage'|trans({ '%familyLabel%':familyLog.label }) }}</h1>

    <turbo-frame id="familyLog_{{ familyLog.uuid }}">
        <twig:Form:FamilyLog:AssignParentForm form="{{ form }}" familyLog="{{ familyLog }}" initialFormData="{{ form.vars.value }}" />
    </turbo-frame>
{% endblock %}

