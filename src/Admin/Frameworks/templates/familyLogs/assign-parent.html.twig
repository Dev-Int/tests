{% extends 'base.html.twig' %}

{% block title %}
    Update FamilyLog | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}
    <h1><twig:Icon:Entities:FamilyLog /> Assign parent to "{{ familyLog.label }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.parent}) }}
    {{ form_row(form.uuid) }}


    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_family_logs_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Assign" />
    </div>

    {{ form_end(form) }}

{% endblock %}

