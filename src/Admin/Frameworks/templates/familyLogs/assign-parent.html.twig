{% extends 'base.html.twig' %}

{% block title %}
    Update FamilyLog | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}
    <h1><twig:Icon:Entities:FamilyLog /> Assign parent to "{{ familyLog.label }}"</h1>

    <turbo-frame id="familyLog_{{ familyLog.uuid }}">
        <h2>Assign parent to "{{ familyLog.label }}"</h2>

        <twig:Form:FamilyLog:AssignParentForm form="{{ form }}" />
    </turbo-frame>
{% endblock %}

