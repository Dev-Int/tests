{% extends 'base.html.twig' %}

{% block title %}
    Update FamilyLog | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:FamilyLog /> Change label "{{ familyLog.label }}"</h1>

    <turbo-frame id="familyLog_{{ familyLog.uuid }}">
        <twig:Form:FamilyLog:ChangeLabelForm form="{{ form }}" familyLog="{{ familyLog }}" />
    </turbo-frame>

{% endblock %}

