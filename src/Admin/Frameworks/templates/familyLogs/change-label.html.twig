{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.familyLog.changeLabel.titleShort'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:FamilyLog /> {{ 'admin.familyLog.changeLabel.titlePage'|trans({ '%familyLabel%': familyLog.label }) }}</h1>

    <turbo-frame id="familyLog_{{ familyLog.uuid }}">
        <twig:Form:FamilyLog:ChangeLabelForm form="{{ form }}" familyLog="{{ familyLog }}" initialFormData="{{ form.vars.value }}" />
    </turbo-frame>

{% endblock %}

