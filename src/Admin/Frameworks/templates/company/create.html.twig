{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.company.create.titlePage'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Company /> {{ 'admin.company.create.titlePage'|trans }}</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.name) }}
    {{ form_row(form.address) }}
    <div class="grid">
        {{ form_row(form.postalCode) }}
        {{ form_row(form.city) }}
    </div>
    {{ form_row(form.country) }}
    <div class="grid">
        {{ form_row(form.phone) }}
        {{ form_row(form.email) }}
    </div>
    {{ form_row(form.contact) }}

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_index') }}" label="{{ 'cancel'|trans }}" />
        <twig:Form:Button:Submit label="{{ 'add'|trans }}" icon="fa-plus" />
    </div>

    {{ form_end(form) }}

{% endblock %}
