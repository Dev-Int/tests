{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.company.update.titlePage'|trans({'%companyName%': companyName}) }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Company /> {{ 'admin.company.update.titlePage'|trans({'%companyName%': companyName}) }}</h1>

    <turbo-frame id="company_update">
        <twig:Form:Company:UpdateForm form="{{ form }}" companyName="{{ companyName }}"/>
    </turbo-frame>

{% endblock %}
