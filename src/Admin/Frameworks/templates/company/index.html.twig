{% extends 'base.html.twig' %}

{% block title %}
    Company | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Company /> Company</h1>

    <main>
        <article >
            <div>
                <turbo-frame id="company_update" class="flex-between">
                    <span></span>
                    <twig:Button:UpdateEntity href="{{ path('admin_company_update', { 'company': company.slug }) }}" label="Update Company" />
                </turbo-frame>
            </div>
            <table>
                <tbody>
                <tr>
                    <td>Name</td>
                    <td>{{ company.name }}</td>
                </tr>
                <tr>
                    <td>Address</td>
                    <td>{{ company.fullAddress | raw }}</td>
                </tr>
                <tr>
                    <td>Phone</td>
                    <td>{{ company.phone }}</td>
                </tr>
                <tr>
                    <td>Email</td>
                    <td>{{ company.email }}</td>
                </tr>
                <tr>
                    <td>Contact</td>
                    <td>{{ company.contact }}</td>
                </tr>
                </tbody>
            </table>
            <twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" />
        </article>
    </main>

{% endblock %}

