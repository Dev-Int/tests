{% extends 'base.html.twig' %}

{% block title %}
    Company | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Company /> Company</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><twig:Button:UpdateEntity href="{{ path('admin_company_update', { 'company': company.slug }) }}" class="w100" label="Update Company" /></li>
                    <li><twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" /></li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <table>
                <tbody>
                <tr>
                    <td>Name</td>
                    <td>{{ company.name }}</td>
                </tr>
                <tr>
                    <td>Address</td>
                    <td>{{ company.fullAddress | raw }}</td>
                </tr>
                <tr>
                    <td>Phone</td>
                    <td>{{ company.phone }}</td>
                </tr>
                <tr>
                    <td>Email</td>
                    <td>{{ company.email }}</td>
                </tr>
                <tr>
                    <td>Contact</td>
                    <td>{{ company.contact }}</td>
                </tr>
                </tbody>
            </table>
        </article>
    </div>

{% endblock %}

