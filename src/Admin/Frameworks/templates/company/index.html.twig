{% extends 'base.html.twig' %}

{% block title %}
    {{ 'admin.company.titlePage'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Company /> {{ 'admin.company.titlePage'|trans }}</h1>

    <main>
        <article >
            <div>
                <turbo-frame id="company_update" class="flex-between">
                    <span></span>
                    <twig:Button:UpdateEntity
                        href="{{ path('admin_company_update', { 'company': company.slug }) }}"
                        label="{{ 'admin.company.update.titleShort'|trans({ '%companyName%':company.name }) }}"
                    />
                </turbo-frame>
            </div>
            <table>
                <tbody>
                <tr>
                    <td>{{ 'name'|trans }}</td>
                    <td>{{ company.name }}</td>
                </tr>
                <tr>
                    <td>{{ 'address'|trans }}</td>
                    <td>{{ company.fullAddress | raw }}</td>
                </tr>
                <tr>
                    <td>{{ 'phone'|trans }}</td>
                    <td>{{ company.phone }}</td>
                </tr>
                <tr>
                    <td>{{ 'email'|trans }}</td>
                    <td>{{ company.email }}</td>
                </tr>
                <tr>
                    <td>{{ 'contact'|trans }}</td>
                    <td>{{ company.contact }}</td>
                </tr>
                </tbody>
            </table>
            <twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" />
        </article>
    </main>

{% endblock %}

