{% extends 'base.html.twig' %}

{% block title %}
    Change contact Supplier | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Supplier /> Change contact "{{ supplier.name }}"</h1>

    <turbo-frame id="supplier_{{ supplier.uuid }}">
        <h2>Change Contact "{{ supplier.name }}"</h2>

        <twig:Form:Supplier:ChangeContactForm form="{{ form }}" />
    </turbo-frame>

{% endblock %}

