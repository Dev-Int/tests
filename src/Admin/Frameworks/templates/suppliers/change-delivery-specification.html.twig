{% extends 'base.html.twig' %}

{% block title %}
    Change delivery specification Supplier | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Supplier /> Change delivery specification "{{ supplier.name }}"</h1>

    <turbo-frame id="supplier_{{ supplier.uuid }}">
        <h2>Change delivery specification "{{ supplier.name }}"</h2>

        <twig:Form:Supplier:ChangeDeliverySpecificationForm form="{{ form }}" />
    </turbo-frame>

{% endblock %}

