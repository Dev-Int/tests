{% extends 'base.html.twig' %}

{% block title %}
    Change delivery specification Supplier | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><i class="fa-solid fa-truck-ramp-box"></i> Change delivery specification "{{ supplier.name }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="grid">
        {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.familyLog}) }}
        <div>
            {{ form_row(form.delayDelivery, {'attr': {'class': 'w50'}}) }}
            {{ form_row(form.orderDays) }}
        </div>
    </div>

    <div class="grid">
        <a href="{{ path('admin_suppliers_index') }}" class="secondary" role="button">Annuler</a>
        <button type="submit">Update</button>
    </div>

    {{ form_end(form) }}

{% endblock %}

