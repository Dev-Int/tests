{% extends 'base.html.twig' %}

{% block title %}
    Create Supplier | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap(['app','familyLog-select']) }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Supplier /> Create Supplier</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.name) }}
    {{ form_row(form.address) }}
    <div class="grid">
        {{ form_row(form.postalCode) }}
        {{ form_row(form.town) }}
        {{ form_row(form.country) }}
    </div>
    <div class="grid">
        {{ form_row(form.phone) }}
        {{ form_row(form.email) }}
    </div>
    <div class="grid">
        {{ form_row(form.contact) }}
        {{ form_row(form.cellphone) }}
    </div>

    <div class="grid">
        {{ include('partials/components/form/_familyLogs-select.html.twig', {familyLog: form.familyLog}) }}
        <div>
            {{ form_row(form.delayDelivery, {'attr': {'class': 'w50'}}) }}
            {{ form_row(form.orderDays) }}
        </div>
    </div>

    <div class="grid">
        <twig:Form:Button:Cancel href="{{ path('admin_suppliers_index') }}" label="Annuler" />
        <twig:Form:Button:Submit label="Create" />
    </div>

    {{ form_end(form) }}

{% endblock %}
