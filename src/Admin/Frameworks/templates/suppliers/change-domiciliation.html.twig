{% extends 'base.html.twig' %}

{% block title %}
    Change domiciliation Supplier | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Supplier /> Change domiciliation "{{ supplier.name }}"</h1>

    <turbo-frame id="supplier_{{ supplier.uuid }}">
        <twig:Form:Supplier:ChangeDomiciliationForm form="{{ form }}" supplier="{{ supplier }}" />
    </turbo-frame>

{% endblock %}

