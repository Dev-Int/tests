{% extends 'base.html.twig' %}

{% block title %}
   {{ 'admin.supplier.changeDomiciliation.titleShort'|trans }} | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Supplier /> {{ 'admin.supplier.changeDomiciliation.titlePage'|trans({ '%supplierName%': supplier.name }) }}</h1>

    <turbo-frame id="supplier_{{ supplier.uuid }}">
        <twig:Form:Supplier:ChangeDomiciliationForm form="{{ form }}" supplier="{{ supplier }}" initialFormData="{{ form.vars.value }}" />
    </turbo-frame>

{% endblock %}

