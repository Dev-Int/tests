{% extends 'base.html.twig' %}

{% block title %}
    Change domiciliation Supplier | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fa-solid fa-truck-ramp-box"></i> Change domiciliation "{{ supplier.name }}"</h1>

    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.address) }}
    <div class="grid">
        {{ form_row(form.postalCode) }}
        {{ form_row(form.town) }}
        {{ form_row(form.country) }}
    </div>
    <div class="grid">
        {{ form_row(form.phone) }}
        {{ form_row(form.email) }}
    </div>

    <div class="grid">
        <a href="{{ path('admin_suppliers_index') }}" class="secondary" role="button">Annuler</a>
        <button type="submit">Update</button>
    </div>

    {{ form_end(form) }}

{% endblock %}

