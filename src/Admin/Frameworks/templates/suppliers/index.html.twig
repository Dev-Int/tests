{% extends 'base.html.twig' %}

{% block title %}
    Suppliers | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Supplier /> Suppliers</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav class="menu">
                <ul>
                    <li><twig:Button:CreateEntity href="{{ path('admin_suppliers_create') }}" class="w100" label="Create Supplier" /></li>
                    <li><twig:Button:BackTo href="{{ path('admin_index') }}" label="Retour à l'administration" /></li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <ul class="w100">
                {% for supplier in suppliers %}
                <li class="li-unstyled flex-between">
                    {{ supplier.name }}
                    <span>
                        <twig:Button:UpdateEntity href="{{ path('admin_suppliers_rename', {'supplier': supplier.uuid}) }}" label="Rename" />
                        <twig:Button:UpdateEntity href="{{ path('admin_supplier_change-domiciliation', {'supplier': supplier.uuid}) }}" label="Change domiciliation" />
                        <twig:Button:UpdateEntity href="{{ path('admin_suppliers_change-contact', {'supplier': supplier.uuid}) }}" label="Change contact" />
                        <twig:Button:UpdateEntity href="{{ path('admin_suppliers_change-delivery-specification', {'supplier': supplier.uuid}) }}" label="Change delivery specification" />
                    </span>
                </li>
                {% endfor %}
            </ul>
        </article>
    </div>

{% endblock %}

