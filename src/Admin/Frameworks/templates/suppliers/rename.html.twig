{% extends 'base.html.twig' %}

{% block title %}
    Rename supplier | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Supplier /> Rename "{{ supplier.name }}"</h1>

    <turbo-frame id="supplier_{{ supplier.uuid }}">
        <h2>Rename "{{ supplier.name }}"</h2>

        <twig:Form:Supplier:RenameForm form="{{ form }}" />
    </turbo-frame>

{% endblock %}
