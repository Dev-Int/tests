{% extends 'base.html.twig' %}

{% block title %}
    Administration | {{ parent() }}
{% endblock %}

{% block body %}

    <h1>Administration</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav id="menu">
                <ul>
                    <li>
                        <a href="{{ path('admin_company_index') }}" role="button" class="w100">
                            <twig:Icon:Entities:Company /> {{ 'admin.company.titlePage'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_units_index') }}" role="button" class="w100">
                            <twig:Icon:Entities:Unit /> {{ 'admin.unit.titlePage'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_taxes_index') }}" role="button" class="w100">
                            <twig:Icon:Entities:Taxe /> {{ 'admin.tax.titlePage'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_family_logs_index') }}" role="button" class="w100">
                            <twig:Icon:Entities:FamilyLog /> {{ 'admin.familyLog.titlePage'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_zone_storages_index') }}" role="button" class="w100">
                            <twig:Icon:Entities:ZoneStorage /> Storage areas
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_suppliers_index') }}" role="button" class="w100">
                            <twig:Icon:Entities:Supplier /> Suppliers
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_articles_index') }}" role="button" class="w100">
                            <twig:Icon:Entities:Article /> Articles
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <p>Here is how you administrate your application.</p>
            <p>You can create, update or archive all parts of the application.</p>
            <p></p>
            <p>Happy use <i class="fa-solid fa-face-smile-wink"></i></p>

            <p class="bottom-element">
                <twig:Button:BackTo  href="{{ path('home') }}" label="Retour à l'accueil" />
            </p>
        </article>
    </div>

{% endblock %}
