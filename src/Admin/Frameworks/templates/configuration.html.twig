{% extends 'base.html.twig' %}

{% block title %}
    Configure | {{ parent() }}
{% endblock %}

{% block body %}

    <h1><i class="fas fa-cogs"></i> Configuration</h1>

    <div class="row">
        <aside class="col-md-3">
            <nav id="menu">
                <ul>
                    <li>
                        <a href="{{ path('admin_company_create') }}" role="button" class="{% if hasCompany %}secondary disable-link {% endif %}w100">
                            {% if hasCompany %}<twig:Icon:Check />
                            {% else %}<twig:Icon:Entities:Company />{% endif%} {{ 'admin.company.create.titleShort'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_configure_application') }}" role="button" class="{% if hasApplication %}secondary disable-link {% endif %}w100">
                            {% if hasApplication %}<twig:Icon:Check />
                            {% else %}<i class="fa-solid fa-cogs"></i>{% endif%} Configure application
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_family_logs_create') }}" role="button" class="{% if hasFamilyLog %}secondary disable-link {% endif %}w100">
                            {% if hasFamilyLog %}<twig:Icon:Check />
                            {% else %}<twig:Icon:Entities:FamilyLog />{% endif %} {{ 'admin.familyLog.create.titleShort'|trans }}
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_zone_storages_create') }}" role="button" class="{% if hasStorage %}secondary disable-link {% endif %}w100">
                            {% if hasStorage %}<twig:Icon:Check />
                            {% else %}<twig:Icon:Entities:ZoneStorage />{% endif %} Create Storage area
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_suppliers_create') }}" role="button" class="{% if hasSupplier %}secondary disable-link {% endif %}w100">
                            {% if hasSupplier %}<twig:Icon:Check />
                            {% else %}<twig:Icon:Entities:Supplier />{% endif %} Create Supplier
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_article_create') }}" role="button" class="{% if hasArticle %}secondary disable-link {% endif %}w100">
                            {% if hasArticle %}<twig:Icon:Check />
                            {% else %}<twig:Icon:Entities:Article />{% endif %} Create Article
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>
        <article class="col-md-9">
            <p>Here you configure your application. Select items in order.</p>
            <p>Each part is important for the proper use of your application.</p>
            <p></p>
            <p>Happy configure ;)</p>

            <p class="bottom-element">
                <twig:Button:BackTo label="Retour à l'accueil" href="{{ path('home') }}" />
            </p>
        </article>
    </div>

{% endblock %}
