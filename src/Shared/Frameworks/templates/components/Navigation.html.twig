<nav>
    <ul>
        <li class="navbar-brand">
            <a href="{{ path('home') }}" class="logo">Application</a>
        </li>
    </ul>
    <ul>
        <li><a href="{{ path('admin_index') }}" role="button">{{ 'admin.titlePage'|trans }}</a></li>
        <li>
            <twig:Button:NavLink
                href="{{ path('inventory_index') }}"
                label="{{ 'inventory.titlePage'|trans }}"
                :disabled="not this.isApplicationReady()"
            />
        </li>
        {% if app.user %}
            <li><a href="{{ path('auth_logout') }}" role="button">{{ 'logout'|trans }}</a></li>
        {% else %}
            <li><a href="{{ path('auth_login') }}" role="button">{{ 'login'|trans }}</a></li>
        {% endif %}
    </ul>
</nav>
