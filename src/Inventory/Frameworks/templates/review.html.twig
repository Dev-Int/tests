{% extends 'base.html.twig' %}

{% block title %}
    {{ 'inventory.review.titlePage'|trans }} | {{ parent() }}
{% endblock %}

{% block importmap %}
    {{ importmap('app') }}
{% endblock %}

{% block body %}

    <h1><twig:Icon:Entities:Inventory /> {{ 'inventory.review.titlePage'|trans }}</h1>

    <main>
        <article>
            <div class="alert {% if discrepancyCount > 0 %}alert-warning{% else %}alert-success{% endif %}">
                <strong>{{ 'inventory.review.summary'|trans }}</strong>
                {% if discrepancyCount > 0 %}
                    {{ 'inventory.review.discrepancy_count'|trans({'%count%': discrepancyCount}) }}
                {% else %}
                    {{ 'inventory.review.no_discrepancy'|trans }}
                {% endif %}
            </div>

            {% if discrepancyCount > 0 %}
                {{ form_start(form) }}
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" id="select-all" title="{{ 'inventory.review.select_all'|trans }}">
                                </th>
                                <th>{{ 'inventory.review.article'|trans }}</th>
                                <th>{{ 'inventory.review.theoreticalStock'|trans }}</th>
                                <th>{{ 'inventory.review.realStock'|trans }}</th>
                                <th>{{ 'inventory.review.difference'|trans }}</th>
                                <th>{{ 'inventory.review.status'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                                <tr class="{% if item.isNegative %}color-error{% elseif item.isPositive %}color-success{% endif %}">
                                    <td>
                                        {% if not item.isReviewed %}
                                            {% for checkbox in form.reviewed_items %}
                                                {% if checkbox.vars.value == item.identifier %}
                                                    {{ form_widget(checkbox, {'attr': {'class': 'item-checkbox'}}) }}
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                    <td>{{ item.articleName }}</td>
                                    <td>{{ item.theoreticalStock }}</td>
                                    <td>{{ item.realStock }}</td>
                                    <td>
                                        {% if item.isPositive %}+{% endif %}
                                        {{ item.difference }}
                                    </td>
                                    <td>
                                        {% if item.isReviewed %}
                                            <span class="badge badge-success">{{ 'inventory.review.reviewed'|trans }}</span>
                                        {% else %}
                                            <span class="badge badge-warning">{{ 'inventory.review.pending'|trans }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                    <div class="grid">
                        <twig:Form:Button:Cancel href="{{ path('inventory_index') }}" label="{{ 'cancel'|trans }}" />
                        <twig:Form:Button:Submit label="{{ 'inventory.review.mark_as_reviewed'|trans }}" icon="fa-save" />
                    </div>
                {{ form_end(form) }}

                {% if zonesWithUnreviewedItems|length > 0 %}
                    <hr>
                    <details>
                        <summary>{{ 'inventory.resume_counting.button'|trans }}</summary>
                        <p class="text-muted">{{ 'inventory.resume_counting.confirm'|trans }}</p>
                        <div class="grid">
                            {% for zoneUuid in zonesWithUnreviewedItems %}
                                <form method="post" action="{{ path('inventory_resume_counting', {
                                    'inventoryUuid': inventory.uuid.toString,
                                    'zoneStorageUuid': zoneUuid
                                }) }}">
                                    <twig:Form:Button:Submit label="Zone {{ loop.index }}" icon="fa-redo" variant="secondary outline" />
                                </form>
                            {% endfor %}
                        </div>
                    </details>
                {% endif %}

                <script>
                    document.getElementById('select-all').addEventListener('change', function() {
                        document.querySelectorAll('.item-checkbox').forEach(function(checkbox) {
                            checkbox.checked = this.checked;
                        }, this);
                    });
                </script>
            {% endif %}

        </article>
    </main>

{% endblock %}
