{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login.titlePage'|trans }}{% endblock %}

{% block body %}
<article class="login-form">
    <h1>{{ 'auth.login.titlePage'|trans }}</h1>

    {% if error %}
        <twig:Flashes label="error" message=" {{ error.messageKey|trans(error.messageData, 'security') }}" />
    {% endif %}

    <form method="post" action="{{ path('auth_login') }}">
        <div>
            <label for="email">{{ 'auth.login.form.email.label'|trans }}</label>
            <input type="email" id="email" name="_email"
                   value="{{ last_username }}" required autofocus>
        </div>

        <div>
            <label for="password">{{ 'auth.login.form.password.label'|trans }}</label>
            <input type="password" id="password" name="_password" required>
        </div>

        <div>
            <label>
                <input type="checkbox" name="_remember_me">
                {{ 'auth.login.form.rememberMe.label'|trans }}
            </label>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div class="grid">
            <twig:Form:Button:Cancel href="{{ path('home') }}" label="{{ 'cancel'|trans }}" />
            <twig:Form:Button:Submit label="{{ 'auth.login.form.submit'|trans }}" icon="fa-right-to-bracket" />
        </div>
    </form>
</article>
{% endblock %}
