{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.reset_password.titlePage'|trans }}{% endblock %}

{% block body %}
    <main>
        <h1>{{ 'auth.reset_password.titlePage'|trans }}</h1>

        {{ form_start(form) }}
        {{ form_errors(form) }}

        {{ form_row(form.password) }}

        <div class="grid">
            <twig:Form:Button:Cancel href="{{ path('home') }}" label="{{ 'cancel'|trans }}" />
            <twig:Form:Button:Submit label="{{ 'auth.reset_password.form.submit'|trans }}" icon="fa-reset" />
        </div>

        {{ form_end(form) }}

    </main>
{% endblock %}
